generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum ArtifactType {
  MESH
  SPLAT
}

model Artifact {
  id             String               @id @default(uuid()) @db.Uuid
  slug           String               @unique
  title          String
  description    String               @default("")
  type           ArtifactType
  thumbnailPath  String?
  contentPath     String
  contentFilename String
  mimeType       String
  sizeBytes      BigInt
  createdAt      DateTime             @default(now())
  updatedAt      DateTime             @updatedAt

  @@index([type, id])
  @@index([title])
  @@map("artifacts")
}
