{
  "name": "mesh-splat-artifact-service",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24 <25"
  },
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "prisma generate && tsc -p tsconfig.build.json",
    "start": "node dist/server.js",
    "test": "vitest run",
    "typecheck": "prisma generate && tsc -p tsconfig.json --noEmit",
    "db:generate": "prisma generate",
    "db:push": "prisma db push",
    "db:seed": "tsx prisma/seed.ts",
    "process:mesh": "tsx scripts/process-mesh-derivative.ts",
    "process:splat": "tsx scripts/process-splat-derivative.ts",
    "process:derivatives": "tsx scripts/process-derivatives.ts",
    "generate:thumbnail": "tsx scripts/generate-thumbnail.ts",
    "setup:local": "tsx scripts/setup-local.ts"
  },
  "dependencies": {
    "@fastify/helmet": "13.1.0",
    "@fastify/rate-limit": "11.2.0",
    "@fastify/secure-session": "8.3.0",
    "@fastify/static": "10.1.3",
    "@prisma/adapter-pg": "7.9.1",
    "@prisma/client": "7.9.1",
    "argon2": "0.44.0",
    "dotenv": "17.4.2",
    "fastify": "5.12.0",
    "jose": "6.2.9",
    "pg": "8.23.0",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@gltf-transform/core": "4.4.2",
    "@gltf-transform/extensions": "4.4.2",
    "@gltf-transform/functions": "4.4.2",
    "@playcanvas/splat-transform": "3.3.0",
    "@types/node": "26.2.0",
    "@types/pg": "8.23.1",
    "meshoptimizer": "1.2.0",
    "prisma": "7.9.1",
    "tsx": "4.23.12",
    "typescript": "7.0.2",
    "vitest": "4.1.10"
  },
  "overrides": {
    "deepmerge-ts": "8.0.0"
  }
}
