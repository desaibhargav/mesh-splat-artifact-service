NODE_ENV=development
HOST=127.0.0.1
PORT=8080
DATABASE_URL=postgresql://YOUR_LOCAL_USER@127.0.0.1:5432/mesh_splat
ARTIFACT_ROOT=./data/assets
AUTH_MODE=demo-session
DEMO_USERNAME=GENERATED_BY_NPM_RUN_SETUP_LOCAL
DEMO_PASSWORD_HASH=GENERATED_BY_NPM_RUN_SETUP_LOCAL
DEMO_SESSION_KEY=GENERATED_64_CHARACTER_HEX_KEY
DEMO_SESSION_TTL_SECONDS=3600

# For future IU OIDC deployment, use AUTH_MODE=oidc-bearer and configure:
# OIDC_ISSUER=https://identity.example.iu.edu
# OIDC_AUDIENCE=mesh-splat-artifact-service
# OIDC_JWKS_URI=https://identity.example.iu.edu/.well-known/jwks.json
